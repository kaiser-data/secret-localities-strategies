# Netlify
.netlify/

# Python
__pycache__/
*.py[cod]
.ruff_cache/
.venv/
venv/

# Training artifacts. ANCHORED on purpose: these are working scratch dirs. An unanchored
# `results/` would also match `runs/*/results/`, and git does not descend into an excluded
# directory, so a later `!runs/**` could not rescue it. Curated run records under runs/
# are tracked - they are the experiment log we reason from.
/organism/outputs/
/organism/checkpoints/
/organism/adapters/
/organism/results/
/organism/figures/
/kaggle_out/
*.safetensors
*.gguf

# Generated datasets: seed-reproducible via `python generate_data.py --all`,
# so they are rebuilt rather than committed. Patterns are unanchored (**/) on
# purpose - the data lives in organism/data/, not the repo root.
**/data/*.jsonl
**/data/_cache/

# Credentials - never commit
kaggle.json
.env

# Blinding: the repository-to-alias key and the sealed pre-unblinding responses. The run
# archive stores only a HASH of the key until the registered unblinding step, so this
# directory leaving the machine would void the blind.
/.audit_private/

# OS
.DS_Store

# Isolated implementation worktrees
/.worktrees/

# graphify knowledge graph — generated, regenerate with `graphify update .`
graphify-out/
